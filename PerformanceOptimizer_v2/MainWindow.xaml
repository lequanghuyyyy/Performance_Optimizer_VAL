<Window x:Class="PerformanceOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PerformanceOptimizer.ViewModels"
        mc:Ignorable="d"
        Title="Windows Performance Studio v2.1 Pro"
        Icon="Resources/app.ico"
        Height="820" Width="1220"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

	<Window.Resources>
		<!-- Card Style: Crisp Native High-Contrast Borders (No Blurry DropShadowEffect) -->
		<Style x:Key="OptimizationCardStyle" TargetType="Border">
			<Setter Property="Background" Value="#131D31"/>
			<Setter Property="BorderBrush" Value="#25354F"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Margin" Value="6"/>
			<Setter Property="Padding" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="BorderBrush" Value="#0284C7"/>
					<Setter Property="Background" Value="#152238"/>
				</DataTrigger>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="BorderBrush" Value="#38BDF8"/>
					<Setter Property="Background" Value="#1C2C4A"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- Modern CheckBox Style -->
		<Style x:Key="CustomCheckBox" TargetType="CheckBox">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="#F8FAFC"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<StackPanel Orientation="Horizontal">
							<Border x:Name="border" Width="20" Height="20" CornerRadius="5" BorderBrush="#475569" BorderThickness="1.5" Background="#0F172A">
								<Path x:Name="checkMark" Data="M3,10 L7,14 L15,5" Stroke="#38BDF8" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
							</Border>
							<ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
						</StackPanel>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="border" Property="Background" Value="#0369A1"/>
								<Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
								<Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Category Filter Button Style -->
		<Style x:Key="CategoryFilterButton" TargetType="Button">
			<Setter Property="Background" Value="#1E293B"/>
			<Setter Property="Foreground" Value="#CBD5E1"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#334155"/>
			<Setter Property="Padding" Value="14,6"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="bd" Property="Background" Value="#0284C7"/>
								<Setter TargetName="bd" Property="BorderBrush" Value="#38BDF8"/>
								<Setter Property="Foreground" Value="#FFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Standard Button Style -->
		<Style x:Key="ActionButton" TargetType="Button">
			<Setter Property="Background" Value="#1E293B"/>
			<Setter Property="Foreground" Value="#F8FAFC"/>
			<Setter Property="BorderBrush" Value="#334155"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#334155"/>
								<Setter TargetName="border" Property="BorderBrush" Value="#64748B"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- ================= ULTRA-THIN MODERN SCROLLBAR (DARK THEME COMPLIANT) ================= -->
		<Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
			<Setter Property="OverridesDefaultStyle" Value="true"/>
			<Setter Property="IsTabStop" Value="false"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Thumb}">
						<Border x:Name="thumbBorder" Background="#24334D" CornerRadius="3" Margin="1"/>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="thumbBorder" Property="Background" Value="#38BDF8"/>
							</Trigger>
							<Trigger Property="IsDragging" Value="True">
								<Setter TargetName="thumbBorder" Property="Background" Value="#0284C7"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="{x:Type ScrollBar}">
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="OverridesDefaultStyle" Value="true"/>
			<Style.Triggers>
				<Trigger Property="Orientation" Value="Vertical">
					<Setter Property="Width" Value="6"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type ScrollBar}">
								<Grid Background="Transparent">
									<Track x:Name="PART_Track" IsDirectionReversed="true">
										<Track.Thumb>
											<Thumb Style="{StaticResource ModernScrollBarThumb}"/>
										</Track.Thumb>
									</Track>
								</Grid>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
				<Trigger Property="Orientation" Value="Horizontal">
					<Setter Property="Height" Value="6"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="{x:Type ScrollBar}">
								<Grid Background="Transparent">
									<Track x:Name="PART_Track">
										<Track.Thumb>
											<Thumb Style="{StaticResource ModernScrollBarThumb}"/>
										</Track.Thumb>
									</Track>
								</Grid>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Trigger>
			</Style.Triggers>
		</Style>

		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</Window.Resources>

	<Grid>
		<!-- Main Layout -->
		<Grid Margin="20">
			<Grid.RowDefinitions>
				<!-- Row 0: Header -->
				<RowDefinition Height="Auto"/>
				<!-- Row 1: Action Bar & Filter Bar -->
				<RowDefinition Height="Auto"/>
				<!-- Row 2: Card Grid View -->
				<RowDefinition Height="*"/>
				<!-- Row 3: Progress & Primary Action Bar -->
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- ================= HEADER ================= -->
			<Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,15">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Title & Tagline -->
					<StackPanel Grid.Column="0">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="⚡" FontSize="22" Foreground="#00F0FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBlock Text="WINDOWS PERFORMANCE STUDIO" FontSize="18" FontWeight="Black" Foreground="#00F0FF" VerticalAlignment="Center"/>
							<Border Background="#065F46" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
								<TextBlock Text="v2.1 PRO UNIVERSAL" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
							</Border>
						</StackPanel>

					</StackPanel>

					<!-- Header Right: Specs Button & Admin Badge -->
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
						<!-- Nút Vanguard Safe Mode -->
						<Button Click="BtnToggleVanguardSafe_Click" Margin="0,0,12,0" Cursor="Hand" ToolTip="Bấm để BẬT/TẮT chế độ bảo vệ Riot Vanguard (Giữ HVCI/VBS để không bị lỗi VAN9005 trên Win 11)">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="{Binding VanguardSafeModeBackgroundBrush}" BorderBrush="{Binding VanguardSafeModeBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,8">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding VanguardSafeModeIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
											<TextBlock Text="{Binding VanguardSafeModeBadge}" FontSize="11" FontWeight="Bold" Foreground="{Binding VanguardSafeModeTextBrush}" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<!-- Nút Thông Số Máy -->
						<Button x:Name="BtnOpenSpecs" Click="BtnOpenSpecs_Click" Margin="0,0,12,0" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="14,8">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
											<TextBlock Text="THÔNG SỐ MÁY" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<!-- Admin Badge -->
						<Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="12,8">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🛡️" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
								<TextBlock Text="ADMINISTRATOR • ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>
			</Border>

			<!-- ================= TOOLBAR & FILTERS (RESPONSIVE 2-TIER) ================= -->
			<Border Grid.Row="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Row 0: Category Filter Pills (Scrollable horizontally if needed) -->
					<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="Bộ lọc:" Foreground="#64748B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="Tất cả" Tag="Tất cả" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="🤖 AI &amp; Copilot (2026)" Tag="🤖 AI &amp; Copilot (2026)" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="⚡ Hiệu năng &amp; CPU" Tag="⚡ Hiệu năng &amp; CPU" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="🎮 GPU &amp; Gaming" Tag="🎮 GPU &amp; Gaming" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="🌐 Mạng &amp; MSI" Tag="🌐 Mạng &amp; MSI" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="🛡️ Dịch vụ &amp; Windows" Tag="🛡️ Dịch vụ &amp; Windows" Click="BtnFilter_Click"/>
							<Button Style="{StaticResource CategoryFilterButton}" Content="Chris_TiTus_Tech" Tag="Chris_TiTus_Tech" Click="BtnFilter_Click"/>
						</StackPanel>
					</ScrollViewer>

					<!-- Row 1: Actions Bar (Counter + Select All / Deselect All + Rescan) -->
					<Border Grid.Row="1" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,8,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<!-- Left: Status & Selection Count -->
							<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="Trạng thái:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<TextBlock Text="{Binding SelectedCount, StringFormat='Đã chọn: {0}'}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
								<TextBlock Text="/" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="4,0,4,0"/>
								<TextBlock Text="{Binding TotalCount, StringFormat='{}{0} mục'}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
							</StackPanel>

							<!-- Right: Selection & Rescan Buttons -->
							<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
								<Button Style="{StaticResource ActionButton}" Content="🔄 Quét lại" Click="BtnRescan_Click" Margin="0,0,8,0" ToolTip="Quét lại trạng thái thực tế của hệ thống"/>
								<Button Style="{StaticResource ActionButton}" Content="✓ Chọn tất cả" Click="BtnSelectAll_Click" Margin="0,0,8,0"/>
								<Button Style="{StaticResource ActionButton}" Content="✕ Bỏ chọn" Click="BtnDeselectAll_Click"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!-- ================= CARD GRID (ADAPTIVE UNIFORMGRID) ================= -->
			<Border Grid.Row="2" Background="#0D1322" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="8">
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding FilteredItems}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="{Binding GridColumns}"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Style="{StaticResource OptimizationCardStyle}" HorizontalAlignment="Stretch" MinHeight="130" MouseLeftButtonUp="Card_MouseLeftButtonUp">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>

										<!-- Card Top: CheckBox + Icon + Title + Status -->
										<Grid Grid.Row="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<!-- CheckBox & Icon -->
											<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
												<CheckBox Style="{StaticResource CustomCheckBox}" IsChecked="{Binding IsSelected}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"/>
												<TextBlock Text="{Binding Icon}" FontSize="16" Margin="6,0,8,0" VerticalAlignment="Center"/>
											</StackPanel>

											<!-- Title -->
											<TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextWrapping="Wrap" VerticalAlignment="Center"/>

											<!-- Status Tag & Individual Revert Button -->
											<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
												<!-- Status Tag -->
												<Border Background="#0F172A" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
													<TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="Bold"/>
												</Border>

												<!-- Nút Hoàn Tác riêng ngay trên item khi đã áp dụng -->
												<Button Click="BtnRevertSingleItem_Click"
														Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}"
														Margin="6,0,0,0"
														VerticalAlignment="Center"
														Cursor="Hand"
														ToolTip="Hoàn tác thiết lập này về mặc định của Windows">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border x:Name="revertBtnBorder" 
																	Background="#201505" 
																	BorderBrush="#D97706" 
																	BorderThickness="1" 
																	CornerRadius="6" 
																	Padding="7,2">
																<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
																	<TextBlock Text="↩" FontSize="11" Foreground="#FBBF24" Margin="0,0,3,0" VerticalAlignment="Center"/>
																	<TextBlock Text="Hoàn tác" FontSize="10" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
																</StackPanel>
															</Border>
															<ControlTemplate.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter TargetName="revertBtnBorder" Property="Background" Value="#92400E"/>
																	<Setter TargetName="revertBtnBorder" Property="BorderBrush" Value="#FBBF24"/>
																</Trigger>
																<Trigger Property="IsPressed" Value="True">
																	<Setter TargetName="revertBtnBorder" Property="Background" Value="#451A03"/>
																</Trigger>
															</ControlTemplate.Triggers>
														</ControlTemplate>
													</Button.Template>
												</Button>
											</StackPanel>
										</Grid>

										<!-- Card Middle: Description (Crisp High-Contrast Text) -->
										<TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11.5" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="17" Margin="28,6,0,8"/>

										<!-- Card Bottom: Badges -->
										<ItemsControl Grid.Row="2" ItemsSource="{Binding Badges}" Margin="28,0,0,0">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<WrapPanel Orientation="Horizontal"/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,5,3">
														<TextBlock Text="{Binding}" Foreground="#38BDF8" FontSize="9.5" FontWeight="SemiBold"/>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>

			<!-- ================= BOTTOM ACTION & PROGRESS PANEL ================= -->
			<Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,15,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<!-- Left: Progress Bar & Human-Readable Current Action -->
					<StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,25,0">
						<!-- Current Action Text (Dễ hiểu cho Low-tech) -->
						<TextBlock Text="{Binding CurrentStepText}" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

						<!-- Progress Bar -->
						<Grid Margin="0,0,0,6">
							<Border Background="#0B0F19" CornerRadius="6" Height="10">
								<ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="10" Background="Transparent" BorderThickness="0" Foreground="#00F0FF"/>
							</Border>
						</Grid>

						<!-- Progress Text Info -->
						<TextBlock Text="{Binding ProgressText}" Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
					</StackPanel>

					<!-- Right: Action Buttons (FPS BOOST TOGGLE + DỌN RAM + Tối Ưu Toàn Diện) -->
					<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
						<!-- Nút BẬT/TẮT CHẾ ĐỘ FPS BOOST (Công tắc gạt Windows 11 Toggle Switch) -->
						<Button Click="BtnToggleFpsBoost_Click" IsEnabled="{Binding IsNotRunning}" Margin="0,0,14,0" Cursor="Hand" ToolTip="{Binding FpsBoostTooltip}">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="btnFpsBoostBorder" CornerRadius="10" Padding="14,8" Background="{Binding FpsBoostButtonBrush}" BorderBrush="{Binding FpsBoostBorderBrush}" BorderThickness="1.5">
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<!-- Icon Sấm Sét ⚡ -->
											<TextBlock Text="⚡" FontSize="18" FontWeight="Black" Foreground="{Binding FpsBoostIconBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>

											<!-- Nhãn Tiêu Đề & Trạng Thái Rõ Ràng -->
											<StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
												<TextBlock Text="FPS BOOST" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
												<TextBlock Text="{Binding FpsBoostModeText}" FontSize="13" FontWeight="Black" Foreground="{Binding FpsBoostTextBrush}"/>
											</StackPanel>

											<!-- Công Tắc Gạt (Sliding Toggle Switch) -->
											<Border Width="46" Height="22" CornerRadius="11" Background="{Binding FpsBoostSwitchTrackBrush}" BorderBrush="{Binding FpsBoostSwitchBorderBrush}" BorderThickness="1.5" VerticalAlignment="Center">
												<Grid>
													<!-- Chữ ON / OFF in chìm trên rãnh gạt -->
													<TextBlock Text="ON" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" Opacity="0.9"/>
													<TextBlock Text="OFF" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>

													<!-- Viên bi tròn trượt Trái / Phải -->
													<Ellipse Width="15" Height="15" Fill="{Binding FpsBoostSwitchKnobBrush}" HorizontalAlignment="{Binding FpsBoostSwitchAlignment}" Margin="2,0,2,0" VerticalAlignment="Center">
														<Ellipse.Effect>
															<DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
														</Ellipse.Effect>
													</Ellipse>
												</Grid>
											</Border>
										</StackPanel>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="btnFpsBoostBorder" Property="Opacity" Value="0.9"/>
										</Trigger>
										<Trigger Property="IsEnabled" Value="False">
											<Setter TargetName="btnFpsBoostBorder" Property="Background" Value="#1E293B"/>
											<Setter TargetName="btnFpsBoostBorder" Property="Opacity" Value="0.4"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<!-- Nút DỌN RAM -->
						<Button Click="BtnQuickRam_Click" IsEnabled="{Binding IsNotRunning}" Margin="0,0,14,0" Cursor="Hand" ToolTip="Giải phóng ngay lập tức toàn bộ bộ nhớ chờ (Standby List) và RAM thừa">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="btnRamBorder" CornerRadius="10" Padding="20,14" Background="#112A24" BorderBrush="#10B981" BorderThickness="1.5">
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
											<TextBlock Text="🧹" FontSize="16" Foreground="#34D399" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<TextBlock Text="DỌN RAM" FontSize="14" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="btnRamBorder" Property="Background" Value="#065F46"/>
											<Setter TargetName="btnRamBorder" Property="BorderBrush" Value="#34D399"/>
										</Trigger>
										<Trigger Property="IsEnabled" Value="False">
											<Setter TargetName="btnRamBorder" Property="Background" Value="#1E293B"/>
											<Setter TargetName="btnRamBorder" Property="Opacity" Value="0.4"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<!-- Large Primary Action Button -->
						<Button Click="BtnApply_Click" IsEnabled="{Binding IsNotRunning}" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="btnBorder" CornerRadius="10" Padding="28,14">
										<Border.Background>
											<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
												<GradientStop Color="#0284C7" Offset="0.0"/>
												<GradientStop Color="#059669" Offset="1.0"/>
											</LinearGradientBrush>
										</Border.Background>
										<Border.Effect>
											<DropShadowEffect BlurRadius="15" Color="#00F0FF" Opacity="0.4" ShadowDepth="0"/>
										</Border.Effect>
										<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
											<TextBlock Text="⚡" FontSize="18" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
											<TextBlock Text="{Binding ApplyButtonText}" FontSize="15" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="btnBorder" Property="Background">
												<Setter.Value>
													<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
														<GradientStop Color="#0EA5E9" Offset="0.0"/>
														<GradientStop Color="#10B981" Offset="1.0"/>
													</LinearGradientBrush>
												</Setter.Value>
											</Setter>
										</Trigger>
										<Trigger Property="IsEnabled" Value="False">
											<Setter TargetName="btnBorder" Property="Background" Value="#334155"/>
											<Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!-- ================= MODAL POPUP: THÔNG SỐ MÁY (CRISP & SHARP) ================= -->
		<Grid Background="#B3000000" Visibility="{Binding IsSpecsPopupOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="999">
			<Border Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="16" Width="680" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Popup Header -->
					<Grid Grid.Row="0" Margin="0,0,0,16">
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="🖥️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBlock Text="THÔNG SỐ PHẦN CỨNG CHI TIẾT" FontSize="18" FontWeight="Black" Foreground="#00F0FF" VerticalAlignment="Center"/>
							</StackPanel>
							<TextBlock Text="Cấu hình hệ thống được tự động phát hiện để tối ưu Gaming &amp; Hiệu năng" Foreground="#CBD5E1" FontSize="12" Margin="28,4,0,0"/>
						</StackPanel>
					</Grid>

					<!-- Popup Content: 4 Main Spec Cards -->
					<Grid Grid.Row="1" Margin="0,0,0,16">
						<Grid.RowDefinitions>
							<RowDefinition Height="*"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Box 1: CPU -->
						<Border Grid.Row="0" Grid.Column="0" Background="#162035" BorderBrush="#25354F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,8,8">
							<StackPanel>
								<TextBlock Text="💻 BỘ VI XỬ LÝ (CPU)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
								<TextBlock Text="{Binding Hardware.CpuName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding Hardware.CpuDetails}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
								<Border Background="#0F172A" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
									<TextBlock Text="{Binding Hardware.CpuArchitectureNote}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
								</Border>
							</StackPanel>
						</Border>

						<!-- Box 2: GPU -->
						<Border Grid.Row="0" Grid.Column="1" Background="#162035" BorderBrush="#25354F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,0,0,8">
							<StackPanel>
								<TextBlock Text="🎮 ĐỒ HỌA (GPU)" FontSize="11" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,6"/>
								<TextBlock Text="{Binding Hardware.GpuName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
								<TextBlock Text="{Binding Hardware.GpuDetails}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
							</StackPanel>
						</Border>

						<!-- Box 3: RAM -->
						<Border Grid.Row="1" Grid.Column="0" Background="#162035" BorderBrush="#25354F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,8,8,0">
							<StackPanel>
								<TextBlock Text="⚡ BỘ NHỚ TRUY XUẤT (RAM)" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,6"/>
								<TextBlock Text="{Binding Hardware.RamTotal}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
								<TextBlock Text="{Binding Hardware.RamDetails}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
							</StackPanel>
						</Border>

						<!-- Box 4: Disk / ROM -->
						<Border Grid.Row="1" Grid.Column="1" Background="#162035" BorderBrush="#25354F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="8,8,0,0">
							<StackPanel>
								<TextBlock Text="💾 Ổ ĐĨA HỆ THỐNG (ROM / DISK)" FontSize="11" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,6"/>
								<TextBlock Text="{Binding Hardware.DiskTotal}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
								<TextBlock Text="{Binding Hardware.DiskDetails}" FontSize="11.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
							</StackPanel>
						</Border>
					</Grid>

					<!-- Popup Footer: Close Button & AI Status -->
					<Grid Grid.Row="2">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="🤖 Quyền riêng tư &amp; AI: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding Hardware.WindowsAiStatus}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
						</StackPanel>

						<Button HorizontalAlignment="Right" Click="BtnCloseSpecs_Click" Cursor="Hand">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="20,8">
										<TextBlock Text="Đóng" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
